{
  "name": "@cloudsage/chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cloudsage/contracts run build && node scripts/prepare-dist.mjs && nest start --watch",
    "build": "tsc -p tsconfig.build.json && node scripts/prepare-dist.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "drizzle-kit migrate",
    "db:seed": "tsx src/database/seed.ts",
    "eval": "tsx scripts/run-eval.ts",
    "eval:langsmith": "tsx scripts/run-langsmith-eval.ts",
    "eval:retrieval": "tsx scripts/run-retrieval-eval.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:graph": "tsx test-graph.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@cloudsage/contracts": "workspace:*",
    "@langchain/classic": "^1.0.40",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@langchain/openai": "^1.5.5",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "argon2": "^0.44.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@xenova/transformers": "^2.17.2",
    "deepagents": "^1.12.3",
    "drizzle-orm": "^0.44.7",
    "js-yaml": "^5.2.2",
    "langchain": "^1.5.4",
    "langsmith": "^0.8.7",
    "mammoth": "^1.12.0",
    "multer": "^2.0.2",
    "pdf-parse": "1.1.1",
    "pino": "9.6.0",
    "pino-pretty": "11.3.0",
    "pg": "^8.22.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "word-extractor": "1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "22.15.3",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.23.12",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  }
}
