{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": true,
    "paths": {
      "@cloudsage/contracts": ["packages/contracts/dist/index.d.ts"],
      "@cloudsage/contracts/*": ["packages/contracts/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test", "scripts", "dist"]
}
