{
  "name": "@cloudsage/contracts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ui-protocol": {
      "types": "./dist/ui-protocol.d.ts",
      "require": "./dist/ui-protocol.js",
      "default": "./dist/ui-protocol.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "require": "./dist/session.js",
      "default": "./dist/session.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').writeFileSync('dist/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
