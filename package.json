{
  "name": "autix",
  "private": true,
  "workspaces": [
    "clients/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:chat-web": "turbo dev --filter=@autix/chat-web",
    "dev:chat": "turbo dev --filter=@autix/chat",
    "build": "turbo build",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.3.12"
}
