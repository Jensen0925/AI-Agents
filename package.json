{
  "name": "cloudsage",
  "private": true,
  "workspaces": [
    "clients/*",
    "services/*",
    "mcp-servers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:chat-web": "turbo dev --filter=@cloudsage/chat-web",
    "dev:admin-web": "turbo dev --filter=@cloudsage/admin-web",
    "dev:chat": "turbo dev --filter=@cloudsage/chat",
    "dev:api": "turbo dev --filter=@cloudsage/chat",
    "build": "turbo build",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.3.12"
}
