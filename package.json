{
  "name": "cloudsage",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "test": "turbo test",
    "dev:chat-web": "turbo dev --filter=@cloudsage/chat-web",
    "dev:admin-web": "turbo dev --filter=@cloudsage/admin-web",
    "dev:chat": "turbo dev --filter=@cloudsage/chat",
    "dev:api": "turbo dev --filter=@cloudsage/chat",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "oxlint": "^1.80.0",
    "turbo": "2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
